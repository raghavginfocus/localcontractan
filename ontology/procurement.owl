<?xml version="1.0"?>
<rdf:RDF xmlns="http://procurement.kg/ontology#"
     xml:base="http://procurement.kg/ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:proc="http://procurement.kg/ontology#">
    
    <owl:Ontology rdf:about="http://procurement.kg/ontology">
        <rdfs:label xml:lang="en">Procurement Contract Ontology</rdfs:label>
        <rdfs:comment xml:lang="en">
            An ontology for modeling procurement contracts, clauses, obligations, 
            risks, and compliance requirements. Designed for knowledge graph-based
            reasoning and RAG systems.
        </rdfs:comment>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    
    <!-- ==================== CLASSES ==================== -->
    
    <!-- Contract -->
    <owl:Class rdf:about="http://procurement.kg/ontology#Contract">
        <rdfs:label xml:lang="en">Contract</rdfs:label>
        <rdfs:comment xml:lang="en">A procurement contract document between parties.</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="http://procurement.kg/ontology#HighValueContract">
        <rdfs:subClassOf rdf:resource="http://procurement.kg/ontology#Contract"/>
        <rdfs:label xml:lang="en">High Value Contract</rdfs:label>
        <rdfs:comment xml:lang="en">A contract with value exceeding threshold (inferred).</rdfs:comment>
    </owl:Class>
    
    <!-- Clause Hierarchy -->
    <owl:Class rdf:about="http://procurement.kg/ontology#Clause">
        <rdfs:label xml:lang="en">Clause</rdfs:label>
        <rdfs:comment xml:lang="en">A clause within a contract.</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="http://procurement.kg/ontology#TerminationClause">
        <rdfs:subClassOf rdf:resource="http://procurement.kg/ontology#Clause"/>
        <rdfs:label xml:lang="en">Termination Clause</rdfs:label>
        <rdfs:comment xml:lang="en">Clause defining contract termination conditions.</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="http://procurement.kg/ontology#PaymentClause">
        <rdfs:subClassOf rdf:resource="http://procurement.kg/ontology#Clause"/>
        <rdfs:label xml:lang="en">Payment Clause</rdfs:label>
        <rdfs:comment xml:lang="en">Clause defining payment terms and conditions.</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="http://procurement.kg/ontology#PenaltyClause">
        <rdfs:subClassOf rdf:resource="http://procurement.kg/ontology#Clause"/>
        <rdfs:label xml:lang="en">Penalty Clause</rdfs:label>
        <rdfs:comment xml:lang="en">Clause defining penalties for breach or delay.</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="http://procurement.kg/ontology#ConfidentialityClause">
        <rdfs:subClassOf rdf:resource="http://procurement.kg/ontology#Clause"/>
        <rdfs:label xml:lang="en">Confidentiality Clause</rdfs:label>
        <rdfs:comment xml:lang="en">Non-disclosure and confidentiality provisions.</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="http://procurement.kg/ontology#IndemnificationClause">
        <rdfs:subClassOf rdf:resource="http://procurement.kg/ontology#Clause"/>
        <rdfs:label xml:lang="en">Indemnification Clause</rdfs:label>
        <rdfs:comment xml:lang="en">Liability and indemnification provisions.</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="http://procurement.kg/ontology#ForceMajeureClause">
        <rdfs:subClassOf rdf:resource="http://procurement.kg/ontology#Clause"/>
        <rdfs:label xml:lang="en">Force Majeure Clause</rdfs:label>
        <rdfs:comment xml:lang="en">Force majeure provisions.</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="http://procurement.kg/ontology#GoverningLawClause">
        <rdfs:subClassOf rdf:resource="http://procurement.kg/ontology#Clause"/>
        <rdfs:label xml:lang="en">Governing Law Clause</rdfs:label>
        <rdfs:comment xml:lang="en">Jurisdiction and governing law provisions.</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="http://procurement.kg/ontology#WarrantyClause">
        <rdfs:subClassOf rdf:resource="http://procurement.kg/ontology#Clause"/>
        <rdfs:label xml:lang="en">Warranty Clause</rdfs:label>
        <rdfs:comment xml:lang="en">Warranties and guarantees.</rdfs:comment>
    </owl:Class>
    
    <!-- Party -->
    <owl:Class rdf:about="http://procurement.kg/ontology#Party">
        <rdfs:label xml:lang="en">Party</rdfs:label>
        <rdfs:comment xml:lang="en">A party to a contract.</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="http://procurement.kg/ontology#Buyer">
        <rdfs:subClassOf rdf:resource="http://procurement.kg/ontology#Party"/>
        <rdfs:label xml:lang="en">Buyer</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="http://procurement.kg/ontology#Supplier">
        <rdfs:subClassOf rdf:resource="http://procurement.kg/ontology#Party"/>
        <rdfs:label xml:lang="en">Supplier</rdfs:label>
    </owl:Class>
    
    <!-- Obligation -->
    <owl:Class rdf:about="http://procurement.kg/ontology#Obligation">
        <rdfs:label xml:lang="en">Obligation</rdfs:label>
        <rdfs:comment xml:lang="en">A contractual obligation.</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="http://procurement.kg/ontology#PaymentObligation">
        <rdfs:subClassOf rdf:resource="http://procurement.kg/ontology#Obligation"/>
        <rdfs:label xml:lang="en">Payment Obligation</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="http://procurement.kg/ontology#DeliveryObligation">
        <rdfs:subClassOf rdf:resource="http://procurement.kg/ontology#Obligation"/>
        <rdfs:label xml:lang="en">Delivery Obligation</rdfs:label>
    </owl:Class>
    
    <!-- Risk -->
    <owl:Class rdf:about="http://procurement.kg/ontology#Risk">
        <rdfs:label xml:lang="en">Risk</rdfs:label>
        <rdfs:comment xml:lang="en">A risk identified in a contract.</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="http://procurement.kg/ontology#TerminationRisk">
        <rdfs:subClassOf rdf:resource="http://procurement.kg/ontology#Risk"/>
        <rdfs:label xml:lang="en">Termination Risk</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="http://procurement.kg/ontology#FinancialRisk">
        <rdfs:subClassOf rdf:resource="http://procurement.kg/ontology#Risk"/>
        <rdfs:label xml:lang="en">Financial Risk</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="http://procurement.kg/ontology#ComplianceRisk">
        <rdfs:subClassOf rdf:resource="http://procurement.kg/ontology#Risk"/>
        <rdfs:label xml:lang="en">Compliance Risk</rdfs:label>
    </owl:Class>
    
    <!-- Jurisdiction -->
    <owl:Class rdf:about="http://procurement.kg/ontology#Jurisdiction">
        <rdfs:label xml:lang="en">Jurisdiction</rdfs:label>
        <rdfs:comment xml:lang="en">A legal jurisdiction.</rdfs:comment>
    </owl:Class>
    
    <!-- Compliance Issue -->
    <owl:Class rdf:about="http://procurement.kg/ontology#ComplianceIssue">
        <rdfs:label xml:lang="en">Compliance Issue</rdfs:label>
        <rdfs:comment xml:lang="en">An identified compliance issue.</rdfs:comment>
    </owl:Class>
    
    <!-- ==================== OBJECT PROPERTIES ==================== -->
    
    <owl:ObjectProperty rdf:about="http://procurement.kg/ontology#hasClause">
        <rdfs:domain rdf:resource="http://procurement.kg/ontology#Contract"/>
        <rdfs:range rdf:resource="http://procurement.kg/ontology#Clause"/>
        <rdfs:label xml:lang="en">has clause</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://procurement.kg/ontology#hasParty">
        <rdfs:domain rdf:resource="http://procurement.kg/ontology#Contract"/>
        <rdfs:range rdf:resource="http://procurement.kg/ontology#Party"/>
        <rdfs:label xml:lang="en">has party</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://procurement.kg/ontology#governedBy">
        <rdfs:domain rdf:resource="http://procurement.kg/ontology#Contract"/>
        <rdfs:range rdf:resource="http://procurement.kg/ontology#Jurisdiction"/>
        <rdfs:label xml:lang="en">governed by</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://procurement.kg/ontology#createsObligation">
        <rdfs:domain rdf:resource="http://procurement.kg/ontology#Clause"/>
        <rdfs:range rdf:resource="http://procurement.kg/ontology#Obligation"/>
        <rdfs:label xml:lang="en">creates obligation</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://procurement.kg/ontology#hasRisk">
        <rdfs:domain rdf:resource="http://procurement.kg/ontology#Contract"/>
        <rdfs:range rdf:resource="http://procurement.kg/ontology#Risk"/>
        <rdfs:label xml:lang="en">has risk</rdfs:label>
        <rdfs:comment xml:lang="en">Contract has an identified risk (from ingestion).</rdfs:comment>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://procurement.kg/ontology#introducesRisk">
        <rdfs:domain rdf:resource="http://procurement.kg/ontology#Clause"/>
        <rdfs:range rdf:resource="http://procurement.kg/ontology#Risk"/>
        <rdfs:label xml:lang="en">introduces risk</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://procurement.kg/ontology#hasComplianceIssue">
        <rdfs:domain rdf:resource="http://procurement.kg/ontology#Contract"/>
        <rdfs:range rdf:resource="http://procurement.kg/ontology#ComplianceIssue"/>
        <rdfs:label xml:lang="en">has compliance issue</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://procurement.kg/ontology#obligorParty">
        <rdfs:domain rdf:resource="http://procurement.kg/ontology#Obligation"/>
        <rdfs:range rdf:resource="http://procurement.kg/ontology#Party"/>
        <rdfs:label xml:lang="en">obligor party</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://procurement.kg/ontology#obligeeParty">
        <rdfs:domain rdf:resource="http://procurement.kg/ontology#Obligation"/>
        <rdfs:range rdf:resource="http://procurement.kg/ontology#Party"/>
        <rdfs:label xml:lang="en">obligee party</rdfs:label>
    </owl:ObjectProperty>
    
    <!-- ==================== DATATYPE PROPERTIES ==================== -->
    
    <owl:DatatypeProperty rdf:about="http://procurement.kg/ontology#noticePeriod">
        <rdfs:domain rdf:resource="http://procurement.kg/ontology#TerminationClause"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">notice period (days)</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://procurement.kg/ontology#contractValue">
        <rdfs:domain rdf:resource="http://procurement.kg/ontology#Contract"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="en">contract value</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://procurement.kg/ontology#effectiveDate">
        <rdfs:domain rdf:resource="http://procurement.kg/ontology#Contract"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="en">effective date</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://procurement.kg/ontology#expirationDate">
        <rdfs:domain rdf:resource="http://procurement.kg/ontology#Contract"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="en">expiration date</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://procurement.kg/ontology#rawText">
        <rdfs:domain rdf:resource="http://procurement.kg/ontology#Clause"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">raw text</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://procurement.kg/ontology#penaltyAmount">
        <rdfs:domain rdf:resource="http://procurement.kg/ontology#PenaltyClause"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="en">penalty amount</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://procurement.kg/ontology#paymentTerms">
        <rdfs:domain rdf:resource="http://procurement.kg/ontology#PaymentClause"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">payment terms</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://procurement.kg/ontology#severity">
        <rdfs:domain rdf:resource="http://procurement.kg/ontology#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">severity</rdfs:label>
        <rdfs:comment xml:lang="en">Risk severity: Low, Medium, High, Critical</rdfs:comment>
    </owl:DatatypeProperty>
    
    <!-- ==================== INDIVIDUALS (Common Instances) ==================== -->
    
    <!-- Jurisdictions -->
    <owl:NamedIndividual rdf:about="http://procurement.kg/ontology#EU">
        <rdf:type rdf:resource="http://procurement.kg/ontology#Jurisdiction"/>
        <rdfs:label xml:lang="en">European Union</rdfs:label>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="http://procurement.kg/ontology#US">
        <rdf:type rdf:resource="http://procurement.kg/ontology#Jurisdiction"/>
        <rdfs:label xml:lang="en">United States</rdfs:label>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="http://procurement.kg/ontology#UK">
        <rdf:type rdf:resource="http://procurement.kg/ontology#Jurisdiction"/>
        <rdfs:label xml:lang="en">United Kingdom</rdfs:label>
    </owl:NamedIndividual>
    
    <!-- Risk Levels -->
    <owl:NamedIndividual rdf:about="http://procurement.kg/ontology#HighTerminationRisk">
        <rdf:type rdf:resource="http://procurement.kg/ontology#TerminationRisk"/>
        <rdfs:label xml:lang="en">High Termination Risk</rdfs:label>
        <proc:severity>High</proc:severity>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="http://procurement.kg/ontology#LowTerminationRisk">
        <rdf:type rdf:resource="http://procurement.kg/ontology#TerminationRisk"/>
        <rdfs:label xml:lang="en">Low Termination Risk</rdfs:label>
        <proc:severity>Low</proc:severity>
    </owl:NamedIndividual>
    
    <!-- Compliance Issues -->
    <owl:NamedIndividual rdf:about="http://procurement.kg/ontology#EUTerminationNotice">
        <rdf:type rdf:resource="http://procurement.kg/ontology#ComplianceIssue"/>
        <rdfs:label xml:lang="en">EU Termination Notice Violation</rdfs:label>
        <rdfs:comment xml:lang="en">
            Contract termination notice period is below EU minimum requirement of 30 days.
        </rdfs:comment>
    </owl:NamedIndividual>

</rdf:RDF>
