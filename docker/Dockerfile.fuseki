# Custom Fuseki image with automatic dataset and ontology initialization
FROM stain/jena-fuseki:latest

# Switch to root for setup
USER root

# Install curl if not present (needed for init script)
# Note: Fuseki base image uses Alpine Linux, so we use apk instead of apt-get
RUN apk add --no-cache curl bash

# Copy ontology and rules files
COPY ontology/ /staging/ontology/
COPY rules/ /staging/rules/

# Copy Fuseki configuration
COPY docker/fuseki-config.ttl /staging/fuseki-config.ttl

# Copy and setup initialization script
COPY docker/init-fuseki.sh /docker-entrypoint.d/init-fuseki.sh
RUN chmod +x /docker-entrypoint.d/init-fuseki.sh

# Create necessary directories
RUN mkdir -p /fuseki/databases/contracts /fuseki/configuration && \
    chown -R fuseki:fuseki /fuseki /staging

# Switch back to fuseki user
USER fuseki

# Environment variables
ENV ADMIN_PASSWORD=admin123
ENV JVM_ARGS="-Xmx2g -Xms512m -Djena.text.lucene.version=LUCENE_9"

EXPOSE 3030

# The base image's entrypoint will run scripts in /docker-entrypoint.d/
# Our init-fuseki.sh will execute after Fuseki starts
