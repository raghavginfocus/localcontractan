# Contract Knowledge Graph Agents - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# FUSEKI SPARQL SERVER
# =============================================================================
FUSEKI_URL=http://localhost:3030
FUSEKI_DATASET=contracts

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# Choose provider: ollama or watsonx (see `agents/src/llm/provider_factory.py`)
LLM_PROVIDER=ollama

# OpenAI (optional)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic (optional, e.g. Claude)
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229

# Ollama (for local LLM - no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
# Previous model (kept for reference)
# OLLAMA_MODEL=llama3:8b
# Current test model (speed-focused)
OLLAMA_MODEL=qwen2.5-coder:7b
# Fallback model if OLLAMA_MODEL is not installed on the configured Ollama server
OLLAMA_FALLBACK_MODEL=llama3:8b

# IBM watsonx.ai (cloud)
# To use watsonx, set LLM_PROVIDER=watsonx and fill all of these:
WATSONX_API_KEY=your-watsonx-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
# Supported models: openai/gpt-oss-120b, meta-llama/llama-3-3-70b-instruct, meta-llama/llama-3-70b-instruct
WATSONX_MODEL_ID=openai/gpt-oss-120b
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# =============================================================================
# MILVUS VECTOR DATABASE
# =============================================================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=contract_clauses

# =============================================================================
# EMBEDDING MODEL
# =============================================================================
#
# Recommended larger model for better retrieval quality:
# - intfloat/e5-large-v2 → 1024-dim embeddings
#
# Make sure this matches Settings.embedding_model / embedding_dim
# in `agents/src/config.py`.
EMBEDDING_MODEL=intfloat/e5-large-v2
EMBEDDING_DIM=1024

# =============================================================================
# ONTOLOGY NAMESPACES
# =============================================================================
PROCUREMENT_NAMESPACE=http://procurement.kg/ontology#
CONTRACT_NAMESPACE=http://procurement.kg/contract#

# =============================================================================
# DOCUMENT PROCESSING
# =============================================================================
UPLOAD_DIRECTORY=./data/uploads
MAX_FILE_SIZE_MB=50

# Ingestion source: legacy (PyPDF2/python-docx) or docling (DocTags + MinIO)
INGESTION_SOURCE=legacy

# Fuseki dataset for retrieval (default: contracts)
RETRIEVAL_FUSEKI_DATASET=contracts
# Milvus collection for retrieval (default: contract_clauses_v2)
RETRIEVAL_MILVUS_COLLECTION=contract_clauses_v2
# Docling pipeline targets (when INGESTION_SOURCE=docling)
DOCLING_FUSEKI_DATASET=contracts_docling
DOCLING_MILVUS_COLLECTION=contract_clauses_docling

# =============================================================================
# OBJECT STORAGE (MinIO / IBM COS - S3-compatible, no AWS S3)
# =============================================================================
# MinIO (local): http://localhost:9000
# IBM COS: https://s3.<region>.cloud-object-storage.appdomain.cloud
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=procurement-contracts
# Region for IBM COS (leave empty for MinIO)
OBJECT_STORAGE_REGION=

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
ENABLE_AGENT_EXPLANATIONS=true

# =============================================================================
# PERFORMANCE OPTIMIZATIONS
# =============================================================================
# Query Result Caching
ENABLE_QUERY_CACHE=true
QUERY_CACHE_SIZE=100
QUERY_CACHE_TTL=3600

# SPARQL Template Matching (skip LLM for common queries)
ENABLE_SPARQL_TEMPLATES=true

# Fast Complexity Detection (rule-based before LLM)
ENABLE_FAST_COMPLEXITY_DETECTION=true

# Skip vector search when KG results are sufficient
SKIP_VECTOR_WHEN_KG_SUFFICIENT=true
KG_SUFFICIENT_THRESHOLD=3
