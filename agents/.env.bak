# Contract Knowledge Graph Agents - Environment Configuration

# =============================================================================
# FUSEKI SPARQL SERVER
# =============================================================================
FUSEKI_URL=http://localhost:3030
FUSEKI_DATASET=contracts
# Edit .env file and add these lines:
FUSEKI_USER=admin
FUSEKI_PASSWORD=admin123
# =============================================================================
# LLM CONFIGURATION - Using Ollama (Local)
# =============================================================================
LLM_PROVIDER=ollama

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama:7b

# OpenAI (not used)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic (not used)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# =============================================================================
# MILVUS VECTOR DATABASE
# =============================================================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=contract_clauses

# =============================================================================
# EMBEDDING MODEL
# =============================================================================
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# =============================================================================
# ONTOLOGY CONFIGURATION
# =============================================================================
ONTOLOGY_PATH=src/contract_kg/schemas/ontology/procurement.owl
PROCUREMENT_NAMESPACE=http://procurement.kg/ontology#
CONTRACT_NAMESPACE=http://procurement.kg/contract#

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# SCHEMA EVOLUTION
# =============================================================================
# Mode: conservative (log only), suggestive (propose), adaptive (auto-extend)
ONTOLOGY_EVOLUTION_MODE=adaptive
GENERATE_OWL_EXTENSIONS=true
GENERATE_RULES=true
