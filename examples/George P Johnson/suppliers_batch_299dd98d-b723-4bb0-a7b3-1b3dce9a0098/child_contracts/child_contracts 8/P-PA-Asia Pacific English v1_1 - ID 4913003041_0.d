\pard\ql\li0\lin0\ri0\rin0 {\b\f2\cf0\fs20 EFFECTIVE DATE OF THI\b0}{\b\f2\cf0\fs20 S\u160 ?PARTICIPATION\u160 ?\b0}{\b\f2\cf0\fs20 AGREEMENT\u160 ?("PA"):\u160 ?\b0}{\ql\f2\cf0\fs24\li0\lin0\ri0\rin0 \par}

