{\header\s15\ql \tqc\tx5040\tqr\tx10080 \tab \tab \par \tab {\f2\cf0\fs24 Participation Agreement}\tab \par \tab {\f2\cf0\fs24 ASEAN}\tab \par \tab \tab {\f2\cf0\fs20 Agreement #\u160 ?}{\f2\cf0\fs20 4998CM0379}{\f2\cf0\fs20 \u160 ?}{\f2\cf0\fs20 \u160 ?}{\f2\cf0\fs20 \u160 ?}\par \tab \tab {\f2\cf0\fs20 PA #\u160 ?}{\f2\cf0\fs20 4908000531}{\f2\cf0\fs20 \u160 ?}{\f2\cf0\fs20 \u160 ?}{\f2\cf0\fs20 \u160 ?}\par \tab \tab \par }

{\footer\s16\ql \tqc\tx5040\tqr\tx10080 {\f2\cf0\fs16 Form Title: Participation Agreement}\tab {\f2\cf0\fs16 Page }{\field{\*\fldinst {\f2\cf0\fs16 PAGE }}{\fldrslt {\f2\cf0\fs16 \noproof 1}}}{\f2\cf0\fs16  of }{\field{\*\fldinst {\f2\cf0\fs16 NUMPAGES }}{\fldrslt {\f2\cf0\fs16 \noproof 1}}}\tab {\f2\cf0\fs16 Revision: 6/04}\par \tab \tab \par }

\pard\ql\li0\lin0\ri0\rin0 {\i\f2\cf0\fs20 Instructional or informational text is identified in italics and should be deleted prior to presentation to Supplier. Language that is either optional or where text should be inserted will be \i0}{\ul\i\f2\cf0\fs20 underlined\i0}{\i\f2\cf0\fs20  throughout the document (delete language or options that are not applicable).\i0}{\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\b\f2\cf0\fs20 EFFECTIVE DATE OF THIS PARTICIPATION AGREEMENT ("PA"): \b0}{\b\f2\cf0\fs20 \u160 ?\b0}{\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\f2\cf0\fs20 This PA between }{\f2\cf0\fs20 IBM Malaysia Sdn Bhd}{\f2\cf0\fs20 \u160 ?(\'93Buyer\'94) and }{\f2\cf0\fs20 George P. Johnson Company}{\f2\cf0\fs20 \u160 ?(\'93Supplier\'94) adopts and incorporates by reference all of the terms and conditions of the Base Agreement\u160 ?}{\f2\cf0\fs20 4998CM0379}{\f2\cf0\fs20 \u160 ? in effect as of the date hereof (\'93Base Agreement\'94) }{\ul\f2\cf0\fs20 and Statement of Work/Master Statement of Work* in effect as of the date hereof (\'93SOW\'94 / \'93Master SOW\'94).}{\f2\cf0\fs20  This PA automatically incorporates any future amendments to the Base Agreement referenced in this PA }{\ul\f2\cf0\fs20 and any future amendments to the SOW/Master SOW*, if referenced in this PA}{\f2\cf0\fs20 , and will be made a part of this PA to the extent that the amendments do not conflict with the terms of this PA. }{\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\i\f2\cf0\fs20 If you are adopting related SOWs/Master SOW, add the following clause:\i0}{\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\f2\cf0\fs20 However}{\f2\cf0\fs20 , }{\ul\f2\cf0\fs20 any future amendments to the SOW/Master SOW referenced in this PA which affect price and part numbers for Deliverables are automatically incorporated and made a part of this PA.}{\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\i\f2\cf0\fs20 *IF THE PA ALSO INCORPORATES EITHER THE SOW OR THE Master SOW, PLEASE INDICATE ABOVE. OTHERWISE, DELETE THE REFERENCE TO THE SOW AND THE Master SOW.\i0}{\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\f2\cf0\fs20 The parties to this PA agree that purchases and sales of the Deliverables, Products or Services, as defined in the Base Agreement, will be conducted in accordance with, and be subject to, the terms and conditions of this PA, the Base Agreement and any applicable Work Authorizations.}{\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\b\f2\cf0\fs20 AMENDMENTS: \b0}{\f2\cf0\fs20 The following terms and conditions amend provisions of the Base Agreement to bring the conduct of the parties' transactions into conformity with local law and practice.}{\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\ls3\fi0\ilvl0\s1\outlinelevel0\jclisttab\tx432\fi0\li0\lin0\ri0\rin0 {\b\f2\cf0\fs20 Warranties\b0}{\ql\f2\cf0\fs24\fi0\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\f2\cf0\fs20 In addition to the representations and warranties in the Section titled }{\b\i\f2\cf0\fs20 \'93Ongoing Warranties\'94\b0\i0}{\f2\cf0\fs20  in the Base Agreement, Supplier represents and warrants: }{\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\f2\cf0\fs20 1. it is familiar with all local laws and regulations pertaining to bribery, corruption and prohibited business practices and has not and will not partake in any actions in relation to the transactions contemplated herein in violation of such laws; }{\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\f2\cf0\fs20 2. it and its Affiliates has not and will not offer, promise or make or agree to make payments or gifts (of money or anything of value) directly or indirectly to anyone for the purpose of influencing or inducing anyone to influence decisions in favor of Buyer;}{\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\f2\cf0\fs20 3. unless expressly disclosed to Buyer in writing prior to the execution of this Agreement, it does not know nor has reason to believe that any of the owners, principals or senior management of Supplier, its Affiliates, or lower tier subcontractors (1) are or were persons acting in an official capacity for or on behalf of a government; or (2) have a familial relationship to persons acting in an official capacity for or on behalf of a government}{\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\ls3\fi0\ilvl0\s1\outlinelevel0\jclisttab\tx432\fi0\li0\lin0\ri0\rin0 {\b\f2\cf0\fs20 Termination\b0}{\ql\f2\cf0\fs24\fi0\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\f2\cf0\fs20 Either party may terminate this PA, without any cancellation charge, if any of the following events occurs in respect of the other party or the terminating party has reasonable grounds to believe that one is likely to occur, namely that the other party: (i) has a meeting convened for the passing of a resolution for its winding up (other than a voluntary liquidation for the purposes of reconstruction); (ii) enters into a scheme or voluntary arrangement with its creditors; (iii) is the subject of a petition presented for the appointment of an administrator; (iv) has a receiver appointed over any of its property or assets; or (v) is the subject of a petition presented for its bankruptcy. Such termination will be effective upon notice in writing to the other party, liquidator, administrator or receiver.}{\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\ls3\fi0\ilvl1\s2\outlinelevel1\jclisttab\tx575\fi0\li0\lin0\ri0\rin0 {\b\i\f2\cf0\fs20 Termination of a SOW or WA\b0\i0}{\ql\f2\cf0\fs24\fi0\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\f2\cf0\fs20 The following clause shall be added into the end of the subsection titled \'93}{\b\i\f2\cf0\fs20 Termination of this Base Agreement\'94\b0\i0}{\f2\cf0\fs20 :}{\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\f2\cf0\fs20 Notwithstanding the foregoing, Supplier recognizes and agrees that Buyer may immediately terminate this Agreement for Cause by written notice to Supplier in the case that (1) Supplier breaches the Ongoing Warranties pertaining to bribery listed above, or (2) when Buyer reasonably believes such a breach has occurred or is likely to occur. For purposes of the subsection titled }{\b\i\f2\cf0\fs20 \'93Termination of a SOW or WA\'94\b0\i0}{\f2\cf0\fs20  in the Base Agreement, the term Cause shall be deemed to include these events.}{\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\ls3\fi0\ilvl0\s1\outlinelevel0\jclisttab\tx432\fi0\li0\lin0\ri0\rin0 {\b\f2\cf0\fs20 Indonesia\b0}{\ql\f2\cf0\fs24\fi0\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\i\f2\cf0\fs20 The following subsection applies only where the applicable WA originates in \i0}{\i\f2\cf0\fs20 Indonesia:\i0}{\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\ls3\fi0\ilvl1\s2\outlinelevel1\jclisttab\tx575\fi0\li0\lin0\ri0\rin0 {\b\i\f2\cf0\fs20 Termination\b0\i0}{\ql\f2\cf0\fs24\fi0\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\f2\cf0\fs20 A termination of this PA in accordance with the conditions stated herein (and at other places of these conditions) shall take effect without the requirement of a court pronouncement, for purposes of which both parties agree to waive the provisions of Articles 1266 and 1267 of the Indonesian Civil Code.}{\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\ls3\fi0\ilvl0\s1\outlinelevel0\jclisttab\tx432\fi0\li0\lin0\ri0\rin0 {\b\f2\cf0\fs20 Thailand\b0}{\ql\f2\cf0\fs24\fi0\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\i\f2\cf0\fs20 The following subsection applies only where the applicable WA originates in Thailand:\i0}{\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

\pard\ql\ls3\fi0\ilvl1\s2\outlinelevel1\jclisttab\tx575\fi0\li0\lin0\ri0\rin0 {\b\i\f2\cf0\fs20 Supplier\rquote s Responsibilities \b0\i0}{\ql\f2\cf0\fs24\fi0\li0\lin0\ri0\rin0 \par}

\pard\ql\li0\lin0\ri0\rin0 {\f2\cf0\fs20 Supplier agrees to abide by the Labour Protection Act such as minimum wage payable, overtime rate, welfare plan, traditional holiday, etc. and the relevant regulations, Supplier\rquote s Work Rule and job safety measures prevailing in Thailand.}{\ql\f2\cf0\fs20\li0\lin0\ri0\rin0 \par}

