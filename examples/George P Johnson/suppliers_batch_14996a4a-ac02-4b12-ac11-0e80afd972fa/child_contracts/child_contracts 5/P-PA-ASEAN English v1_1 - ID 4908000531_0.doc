\pard\ql\ls3\fi0\ilvl0\s1\outlinelevel0\jclisttab\tx432\fi0\li0\lin0\ri0\rin0 {\b\f2\cf0\fs20 Prior Communications and Order of Precedence\b0}{\ql\f2\cf0\fs24\fi0\li0\lin0\ri0\rin0 \par}

